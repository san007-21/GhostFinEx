# GhostFinEx Edge Functions — LOCAL DEVELOPMENT secrets example.
# Copy to supabase/functions/.env (git-ignored) and fill in for local runs:
#   supabase functions serve --env-file supabase/functions/.env
#
# NEVER commit the filled-in file. In hosted projects set these with:
#   supabase secrets set HF_TOKEN=... HF_CHAT_MODEL=...
# The real token value must never appear in any repository file.

# Hugging Face token — REQUIRED for ghost-ai. Create at huggingface.co/settings/tokens
# (fine-grained token with "Make calls to Inference Providers" permission).
HF_TOKEN=<SET_IN_SUPABASE_SECRET>

# Chat model for ghost-ai — OPTIONAL. Dev default in code:
#   meta-llama/Llama-3.2-3B-Instruct
# Verify availability of any model you configure on the Inference Providers router.
HF_CHAT_MODEL=<model-id>

# Optional: embedding model override (default gte-small, 384-dim — changing it
# requires the matching vector(N) column change in database/rag_schema.sql).
# RAG_EMBEDDING_MODEL=gte-small

# Tavily API key — REQUIRED for web-search (current prices, deals, product
# research). Create at app.tavily.com/home. In hosted projects:
#   supabase secrets set TAVILY_API_KEY=...
TAVILY_API_KEY=<SET_IN_SUPABASE_SECRET>

# Optional: shared secret gating rag-ingest ingestion.
# RAG_INGEST_TOKEN=<random-string>

# Optional: restrict CORS to the app origin in production.
# ALLOWED_ORIGIN=https://your-app.example
