# GhostFinEx frontend environment — copy to frontend/.env and fill in.
# NEVER commit the filled-in file; real secrets stay out of Git.
# Only the PUBLIC anon/publishable key belongs in the frontend.
# NEVER put SUPABASE_SERVICE_ROLE_KEY (or any server secret) here.

VITE_SUPABASE_URL=

# Anon key — either the classic name or the newer "publishable" name works
# (the client accepts both):
VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_PUBLISHABLE_KEY=
